{
  "name": "Virtual Serial Studio",
  "base_url": "https://virtual-serial-studio.com/",
  "repo": "iainchesworthlabs/virtual-serial-studio",
  "tokens": "apps/vss_gui/src/theme/resources/tokens.json",
  "nav": [
    {"file": "features.html", "label": "Features"},
    {"file": "editions.html", "label": "Editions"},
    {"file": "plugins.html", "label": "Plugins"},
    {"file": "downloads.html", "label": "Downloads"},
    {"file": "documentation.html", "label": "Documentation"},
    {"file": "support.html", "label": "Support"}
  ],
  "copy": [
    {"from": "apps/vss_gui/assets/icon/vss_gui.svg", "to": "img/icon.svg"},
    {"from": "apps/vss_gui/assets/icon/png/vss_gui_32.png", "to": "img/icon-32.png"},
    {"from": "apps/vss_gui/assets/icon/png/vss_gui_256.png", "to": "img/icon-256.png"},
    {"from": "docs/signing-key.asc", "to": "signing-key.asc"}
  ],
  "download_rules": [
    {"match": "-windows-x86_64-testsigned\\.exe$", "platform": "Windows", "label": "Installer, with the test-signed driver"},
    {"match": "-windows-x86_64-testsigned\\.zip$", "platform": "Windows", "label": "Zip archive, no installer"},
    {"match": "-windows-x86_64.*\\.exe$", "platform": "Windows", "label": "Installer"},
    {"match": "-windows-x86_64.*\\.zip$", "platform": "Windows", "label": "Zip archive, no installer"},
    {"match": "-macos-arm64\\.dmg$", "platform": "macOS", "label": "Disk image, Apple silicon"},
    {"match": "-macos-arm64\\.tar\\.gz$", "platform": "macOS", "label": "Archive, Apple silicon"},
    {"match": "_amd64\\.deb$", "platform": "Linux", "label": "Package for Debian and Ubuntu, x86-64"},
    {"match": "\\.x86_64\\.rpm$", "platform": "Linux", "label": "Package for Fedora and RHEL, x86-64"},
    {"match": "-linux-x86_64\\.tar\\.gz$", "platform": "Linux", "label": "Archive, x86-64"},
    {"match": "^SHA512SUMS$", "platform": "Checksums and contents", "label": "SHA-512 checksums of every file"},
    {"match": "^sbom\\.spdx\\.json$", "platform": "Checksums and contents", "label": "Software bill of materials, SPDX"}
  ],
  "external_paths": ["docs/"],
  "allowed_link_hosts": ["github.com", "www.gnu.org"],
  "draft_pages": ["licence.html", "privacy.html", "editions.html"],
  "contrast_pairs": [
    ["ink", "ground", 4.5],
    ["ink", "panel", 4.5],
    ["ink", "sunken", 4.5],
    ["ink", "fill", 4.5],
    ["ink", "fillHover", 4.5],
    ["ink2", "ground", 4.5],
    ["ink2", "panel", 4.5],
    ["ink2", "sunken", 4.5],
    ["ink2", "fill", 4.5],
    ["ink3", "panel", 4.5],
    ["ink3", "sunken", 4.5],
    ["accentText", "panel", 4.5],
    ["accentText", "ground", 4.5],
    ["accentText", "sunken", 4.5],
    ["accentText", "accentSoft", 4.5],
    ["onAccent", "accent", 4.5],
    ["onAccent", "accentHover", 4.5],
    ["ok", "okSoft", 4.5],
    ["amber", "amberSoft", 4.5],
    ["violet", "violetSoft", 4.5],
    ["noteInfoText", "accentSoft", 4.5],
    ["noteWarnText", "amberSoft", 4.5],
    ["noteOkText", "okSoft", 4.5],
    ["focus", "ground", 3.0],
    ["focus", "panel", 3.0],
    ["control", "panel", 3.0]
  ]
}
