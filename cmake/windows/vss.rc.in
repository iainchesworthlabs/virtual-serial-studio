// SPDX-License-Identifier: GPL-3.0-or-later
//
// Version information and manifest of @VSS_TARGET@, generated by
// cmake/VssWindowsResources.cmake.

#include <winver.h>

// The program's icon. Windows shows the lowest-numbered icon in Explorer, the
// taskbar and the Start menu. The line is empty for a program without one
// (set the VSS_ICON property of its target).
@VSS_ICON_RESOURCE@

// With the MSVC linker the manifest is merged as a link input and this line is
// empty. Elsewhere it is resource 1 of type 24 (RT_MANIFEST).
@VSS_MANIFEST_RESOURCE@

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @VSS_VERSION_COMMA@
 PRODUCTVERSION @VSS_VERSION_COMMA@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Iain Chesworth Labs"
            VALUE "FileDescription", "@VSS_FILE_DESCRIPTION@"
            VALUE "FileVersion", "@VSS_VERSION_DOTTED@"
            VALUE "InternalName", "@VSS_TARGET@"
            VALUE "LegalCopyright", "Copyright (c) 2026 Virtual Serial Studio contributors. GPL-3.0-or-later."
            VALUE "OriginalFilename", "@VSS_OUTPUT_NAME@.exe"
            VALUE "ProductName", "Virtual Serial Studio"
            VALUE "ProductVersion", "@VSS_VERSION_DOTTED@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
