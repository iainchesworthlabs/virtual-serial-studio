{
  "docs": [
    "docs/**",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "AGENTS.md",
    "adapters/**/*.md",
    "apps/**/README.md",
    "libs/**/README.md",
    "cmake/**/README.md",
    "LICENSE*",
    "changelog.d/**",
    "mkdocs.yml",
    "requirements/docs.in",
    "requirements/docs.txt",
    "tools/docs/**",
    ".github/actions/docs-site/**",
    "tools/ci/site_address.py",
    "tools/ci/site_tools.py",
    "tools/ci/check_site_*.py",
    "tools/ci/check_release_data.py",
    "tools/ci/test_site_*.py"
  ],
  "no_build": [
    ".github/dependabot.yml",
    ".github/repo-settings.json",
    ".github/labels.json",
    "REUSE.toml",
    ".editorconfig",
    "LICENSES/**",
    ".clang-format",
    ".clang-tidy",
    "apps/**/.clang-tidy",
    "drivers/windows/vsscom/driver.c",
    "drivers/windows/vsscom/public.h",
    "drivers/windows/vsscom/*.inf",
    "drivers/windows/vsscom/*.vcxproj",
    "drivers/windows/build.ps1",
    "drivers/windows/test/**",
    "drivers/windows/README.md"
  ],
  "build": [
    "libs/**",
    "apps/**",
    "tests/**",
    "perf/**",
    "tools/**",
    "THIRD_PARTY_NOTICES.md",
    "CMakeLists.txt",
    "CMakePresets.json",
    "vcpkg.json",
    "vcpkg-configuration.json",
    "cmake/**",
    "drivers/windows/vsscom/core/**"
  ],
  "gui": [
    "apps/**",
    "libs/**",
    "cmake/**",
    "THIRD_PARTY_NOTICES.md",
    "CMakeLists.txt",
    "CMakePresets.json",
    "vcpkg.json",
    "vcpkg-configuration.json",
    "**/*.qml",
    "**/*.ui",
    "**/*.ts"
  ],
  "machinery": [
    ".github/workflows/**",
    ".github/actions/**",
    ".github/ci/**",
    ".github/toolchain-versions.json",
    "tools/ci/**"
  ],
  "driver": [
    "drivers/windows/**"
  ],
  "perf": [
    "libs/**",
    "perf/**",
    "cmake/**",
    "CMakeLists.txt",
    "CMakePresets.json",
    "vcpkg.json",
    "vcpkg-configuration.json",
    "drivers/windows/vsscom/core/**"
  ],
  "platform": [
    "libs/**/platform/**",
    "apps/**/platform/**",
    "tests/**/platform/**",
    "cmake/**",
    "CMakeLists.txt",
    "CMakePresets.json",
    "vcpkg.json",
    "vcpkg-configuration.json",
    "tools/pty_loopback.py"
  ],
  "threads_always": [
    "cmake/**",
    "CMakeLists.txt",
    "CMakePresets.json",
    "vcpkg.json",
    "vcpkg-configuration.json"
  ],
  "threads_scan": [
    "libs/**",
    "apps/**",
    "tests/**",
    "perf/**"
  ],
  "threads_tokens": "std::(thread|jthread|mutex|shared_mutex|recursive_mutex|timed_mutex|condition_variable|atomic|stop_token|stop_source|future|promise|async|latch|barrier|counting_semaphore|lock_guard|unique_lock|scoped_lock|memory_order)|\\bstrand\\b|co_spawn|io_context|boost::asio::(post|dispatch)|\\bQThread|\\bQMutex|QtConcurrent|thread_local"
}
