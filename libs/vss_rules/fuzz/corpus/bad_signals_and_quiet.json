{
 "attach": {
  "port": "meter-17",
  "role": "peer"
 },
 "signals": [
  "a",
  "a",
  "",
  3
 ],
 "rules": [
  {
   "name": "zero",
   "when": {
    "quiet_us": 0
   },
   "do": [
    {
     "mark": "m"
    }
   ]
  },
  {
   "name": "too long",
   "when": {
    "quiet_us": 60000001
   },
   "do": [
    {
     "mark": "m"
    }
   ]
  },
  {
   "name": "undeclared",
   "when": {
    "signal": "missing"
   },
   "do": [
    {
     "mark": "m",
     "after": "cause"
    }
   ]
  },
  {
   "name": "two kinds",
   "when": {
    "bytes": "01",
    "quiet_us": 5,
    "signal": "a"
   },
   "do": [
    {
     "mark": "m",
     "after": "cause"
    }
   ]
  },
  {
   "name": "cause on bytes",
   "when": {
    "bytes": "02"
   },
   "do": [
    {
     "mark": "m",
     "after": "cause"
    }
   ]
  },
  {
   "name": "range",
   "when": {
    "signal": "a"
   },
   "do": [
    {
     "reply": [
      {
       "match": [
        0,
        256
       ]
      }
     ]
    },
    {
     "pass": true
    }
   ]
  },
  {
   "name": "wrong types",
   "when": {
    "quiet": 5,
    "signal": 7,
    "quiet_us": "5"
   },
   "do": []
  }
 ]
}
