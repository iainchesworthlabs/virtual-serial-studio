{
  "manifest_version": 1,
  "id": "com.example.report",
  "name": "Report",
  "version": "1.0.0",
  "requires": { "api": { "min": "1.0", "max": "1.x" } },
  "run": { "executable": "bin/report", "platforms": ["macos-arm64"] },
  "permissions": [
    { "name": "bundle.section", "reason": "Adds a section to bundles." }
  ],
  "contributes": {
    "bundle_sections": [
      { "id": "state", "title": "State" },
      { "id": "detail", "title": { "en": "Detail", "de": "Einzelheiten" },
        "sensitive": false,
        "parameters": [
          { "id": "lines", "type": "int", "min": 1, "max": 1000,
            "default": 100, "label": "Lines" }
        ] }
    ]
  }
}
