{
  "manifest_version": 1,
  "id": "com.example.modbus-decoder",
  "name": "Modbus decoder",
  "version": "1.0.0",
  "requires": { "api": { "min": "1.0", "max": "1.x" } },
  "run": { "executable": "bin/decode", "platforms": ["linux-x64"] },
  "permissions": [
    { "name": "traffic.tap", "reason": "Reads the traffic it decodes." },
    { "name": "modifier.inline", "reason": "Not allowed for a decoder." }
  ],
  "extension_points": [
    {
      "kind": "decoder",
      "id": "modbus-rtu",
      "name": "Modbus RTU",
      "timing": { "class": "inline", "budget_us": 250 }
    }
  ]
}
